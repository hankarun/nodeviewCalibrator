{
  "name": "nodeviewcalibrator",
  "version": "1.3.0",
  "description": "A display calibration tool for multi-display setups with 3D visualization",
  "main": "desktop/main.js",
  "scripts": {
    "start-web": "node web/server.js",
    "start": "electron .",
    "test": "node --test test/",
    "lint": "eslint .",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^35.1.4",
    "electron-builder": "^24.4.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "three": "^0.183.2"
  },
  "build": {
    "appId": "com.yourcompany.nodeviewcalibrator",
    "productName": "Node View Calibrator",
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!dist",
      "!build",
      "!test",
      "!**/.vscode",
      "!**/.idea",
      "!**/.vs",
      "!**/.github",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.gitignore,.npmignore}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Node View Calibrator"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "hankarun",
      "repo": "nodeviewCalibrator"
    },
    "forceCodeSigning": false
  }
}
